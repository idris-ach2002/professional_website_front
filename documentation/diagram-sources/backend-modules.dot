digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.45", ranksep="0.7", splines=ortho, fontname="Inter", label="Architecture modulaire Backend", labelloc=t, fontsize=24, fontcolor="#e7e2ff"];
