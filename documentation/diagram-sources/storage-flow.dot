digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.45", ranksep="0.65", splines=ortho, fontname="Inter", label="Flux de stockage de fichiers", labelloc=t, fontsize=24, fontcolor="#dff9ee"];
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=10.5, color="#3e9277", fillcolor="#10362d", fontcolor="#f0fff9"];
  edge [color="#66c9a7", fontcolor="#b6ead9", fontname="Inter", fontsize=9];
  admin [label="Admin React\nfile picker"];
  csrf [label="authApi\ncredentials + CSRF"];
  upload [label="FileUploadController"];
  policy [label="UploadPolicy\nnom · taille · type"];
  abstraction [label="StorageService"];
  local [label="FileSystemStorageService\ndéveloppement"];
  cloud [label="CloudinaryStorageService\nproduction"];
  url [label="URL publique persistée\ndans Profile / Project"];
  public [label="Portfolio public"];
  admin -> csrf -> upload -> policy -> abstraction;
  abstraction -> local [style=dashed, label="provider local"];
  abstraction -> cloud [label="provider cloudinary"];
  local -> url;
  cloud -> url;
  url -> public;
}
