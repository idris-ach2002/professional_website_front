# Public URL of the Spring Boot backend.
VITE_API_BASE_URL=https://your-backend.example.com

# Keep false/empty in production. Set true only to bypass the Vite proxy locally.
VITE_USE_DIRECT_BACKEND=false

# Public production origin used by the post-build SEO generator.
# Example: https://portfolio.example.com
VITE_PUBLIC_SITE_URL=

# Backend source used by the static SEO build.
# In GitHub Actions, configure the repository/environment variable PUBLIC_API_BASE_URL.
PUBLIC_API_BASE_URL=https://your-backend.example.com

# Production should require a real backend snapshot.
STATIC_SNAPSHOT_REQUIRED=false
