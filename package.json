{
  "name": "professional-website-front-gsap-ocean-archipelago",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean-public-legacy.mjs",
    "build": "npm run check:retired && npm run check:source-tree && npm run check:css && npm run check:responsive && npm run check:timeline-motion && npm run check:high-refresh && npm run check:localization && npm run check:stability-freeze && vite build && npm run generate:static && npm run check:static-seo && npm run check:performance",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean": "rm -rf .cache .tmp lib build node_modules",
    "cf:deploy": "npx --yes wrangler@latest deploy",
    "check:retired": "node scripts/check-retired-modules.mjs",
    "check:css": "node scripts/check-css-architecture.mjs && node scripts/check-css-orphans.mjs && node scripts/check-css-quality.mjs",
    "generate:static": "node scripts/generate-static-pages.mjs",
    "check:localization": "node scripts/check-localization.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:functional && npm run test:e2e:responsive && npm run test:e2e:stability && npm run test:e2e:vitals",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "ci:quality": "npm run lint && npm run test:coverage && npm run build",
    "ci:verify": "npm run ci:quality && npm run test:e2e",
    "check:static-seo": "node scripts/check-static-seo.mjs",
    "check:performance": "node scripts/check-performance-budgets.mjs",
    "test:e2e:functional": "playwright test --grep-invert \"@vitals|@responsive|@stability\"",
    "test:e2e:vitals": "playwright test --project=chromium --grep @vitals --workers=1",
    "check:responsive": "node scripts/check-responsive-contract.mjs",
    "test:e2e:responsive": "playwright test --project=chromium --grep @responsive",
    "check:timeline-motion": "node scripts/check-timeline-motion.mjs",
    "check:high-refresh": "node scripts/check-high-refresh.mjs",
    "test:e2e:stability": "playwright test --grep @stability",
    "check:source-tree": "node scripts/check-source-tree.mjs",
    "check:stability-freeze": "node scripts/check-stability-freeze.mjs",
    "ci:freeze": "npm run ci:verify",
    "test:workers": "node scripts/test-worker-policy.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "three": "^0.184.0",
    "gsap": "3.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10 <12"
  }
}
